  "scripts": {
    "clean": "node scripts/clean.cjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build:main": "tsdown",
    "build:renderer": "vite build",
    "build:app": "pnpm run clean && pnpm run typecheck && pnpm run build:main && pnpm run build:renderer",
    "build": "pnpm -w run build:lib && pnpm run build:app",
    "verify:runtime-closure": "tsx ../../../scripts/verify-runtime-closure.ts --manifest=downstream/apps/desktop/package.json",
    "start": "electron .",
    "dev": "pnpm run build && electron .",
    "package:development": "pnpm run build && pnpm run verify:runtime-closure && node scripts/package.cjs --target=host",
    "package:mac": "pnpm run build && pnpm run verify:runtime-closure && node scripts/package.cjs --target=darwin-arm64,darwin-x64",
    "package:windows": "pnpm run build && pnpm run verify:runtime-closure && node scripts/package.cjs --target=win32-x64"
  },

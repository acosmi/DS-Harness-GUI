{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dshgui.com/schemas/support-matrix.schema.json",
  "title": "DSH-GUI platform support matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtime", "targets", "unsupported"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "runtime": { "type": "string", "pattern": "^Electron [0-9]+\\.[0-9]+\\.[0-9]+$" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "arch", "minimumOs", "buildRunner", "localEvidence"],
        "properties": {
          "platform": { "enum": ["darwin", "win32"] },
          "arch": { "enum": ["arm64", "x64"] },
          "minimumOs": { "type": "string", "minLength": 1 },
          "buildRunner": { "type": "string", "minLength": 1 },
          "localEvidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unsupported": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

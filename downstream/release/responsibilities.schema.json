{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dshgui.com/schemas/responsibilities.schema.json",
  "title": "DSH-GUI responsibility ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "roles"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "backup", "evidence", "due", "escalationHours"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "owner": { "type": ["string", "null"], "minLength": 1 },
          "backup": { "type": ["string", "null"], "minLength": 1 },
          "evidence": { "type": ["string", "null"], "minLength": 1 },
          "due": { "type": ["string", "null"], "format": "date" },
          "escalationHours": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}

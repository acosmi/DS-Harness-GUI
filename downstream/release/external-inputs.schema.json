{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dshgui.com/schemas/external-inputs.schema.json",
  "title": "DSH-GUI external-input ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inputs"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "releaseBlocking", "ownerRole", "fallback"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "status": { "enum": ["blocked", "ready"] },
          "releaseBlocking": { "type": "boolean" },
          "ownerRole": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "fallback": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

  "genericPatches": [
    {
      "path": "packages/client/connection",
      "purpose": "Treat the Electron app: renderer protocol as loopback so privileged Host methods stay available without a forked carrier."
    },
    {
      "path": "packages/typert/generator",
      "purpose": "Let aggregate compiler faces discover private product packages under the generic downstream package root."
    },
    {
      "path": "packages/client/modules",
      "purpose": "Export parser-stage boot assets from bootInjections so a packaged renderer can emit the same queue facade as the HTTP shell."
    },
    {
      "path": "packages/client/tsdown.client.ts",
      "purpose": "Allow a private product bundle to name generated wire-only modules that are safe to inline without expanding the shared runtime table."
    },
    {
      "path": "packages/client/ui-sidebar",
      "purpose": "Allow product bundles to replace both expanded and collapsed sidebar brand visuals through one variant-aware root-scoped slot while retaining the upstream defaults and shell behavior."
    },
    {
      "path": "packages/client/ui-conversation",
      "purpose": "Allow product bundles to replace the blank-session hero mark through an optional root-scoped slot while retaining the upstream fish fallback and hero layout."
    },
    {
      "path": "packages/client/ui-model-selection",
      "purpose": "Keep an in-flight session.selectModel from being discarded by a concurrent directory reload."
    },
    {
      "path": "vendor/loader/src/config/utils.ts",
      "purpose": "Create the JavaScript expression evaluator only when a Node configuration uses an expression so expression-free browser bundles can enforce CSP without unsafe-eval."
    },
    {
      "path": "workspace-integration",
      "purpose": "Register downstream workspaces, compiler faces, build entries, test discovery and the pinned SDK dependency without changing upstream product behavior."
    },
    {
      "path": ".github/workflows",
      "purpose": "DSH-GUI does not start pull-request GitHub Actions; maintainers dispatch CI through the GitHub API or Actions UI, and main does not require Actions status checks."
    }
  ],
